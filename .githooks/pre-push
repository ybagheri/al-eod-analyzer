#!/bin/sh
# pre-push hook: full quality gate + plan-compliance (plan v2.6 §8.3).
# --no-verify is FORBIDDEN (AGENTS.md rule 5).
set -e
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY=python
PATH="$ROOT/.venv/Scripts:$PATH"

"$PY" -m tasks check
echo "[pre-push] gate OK"
